<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>xray-content-bench</AssemblyName>
    <RootNamespace>XRay.Content.Bench</RootNamespace>
    <!-- Benchmarks must measure steady-state JIT-compiled code, so tiered compilation's
         quick tier and OSR are left on (they are the shipping default) but the run does a
         full warm-up pass first. Server GC matches how a batch consumer would be deployed. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/XRay.Content/XRay.Content.csproj" />
  </ItemGroup>
</Project>
