<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>XRay.OnnxParity</RootNamespace>
    <AssemblyName>xray-onnx-parity</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/XRay/XRay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harness drives internals directly: it must see individual node outputs, which
         are not part of the package's public surface. -->
    <Using Include="XRay.Internal.Onnx" />
  </ItemGroup>

</Project>
