<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paperless.Content</RootNamespace>
    <AssemblyName>Paperless.Content</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>Paperless.Content</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Curiosity GmbH</Authors>
    <Description>Paperless.Content is a pure-managed content-extraction engine for .NET, a native C# port of the Rust `xberg` engine. Extracts text, metadata, tables and structured content from Office documents, PDF, HTML, email, archives and more. Extraction itself is pure managed; the optional OCR pass is off by default and brings native dependencies (SkiaSharp, PDFium) when enabled.</Description>
    <!-- Not plain MIT: three ported Rust crates are Apache-2.0 only. See
         THIRD_PARTY_NOTICES.md for which files and why. -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>document;extraction;pdf;docx;xlsx;pptx;text;markdown;html</PackageTags>
    <RepositoryUrl>https://github.com/curiosity-ai/xberg</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/curiosity-ai/xberg/tree/main/dotnet</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paperless.Content.Tests" />
    <!-- Matches the tool's AssemblyName, not its project name. -->
    <InternalsVisibleTo Include="paperless-content-onnx-parity" />
    <InternalsVisibleTo Include="paperless-content-bench" />
    <InternalsVisibleTo Include="paperless-content-testrunner" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.Fonts" Version="2.0.9" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <!-- The optional OCR pass; see the OCR section of dotnet/Claude.md. `PaddleOCR` is a managed
         recognizer whose only native dependency is SkiaSharp; `PaddleOCR.Pdf` adds PDFium, which
         is what rasterises a scanned page so ScanOnly has pixels to read. Both load lazily and
         only once a caller turns OCR on. -->
    <PackageReference Include="PaddleOCR" Version="26.8.4668" />
    <PackageReference Include="PaddleOCR.Pdf" Version="26.8.4668" />
  </ItemGroup>

</Project>
