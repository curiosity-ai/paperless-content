<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- No RuntimeIdentifier / native asset wiring here on purpose: the
         wrapper script (scripts/ci/smoke-test-musl-csharp-ffi.sh) copies the
         freshly cross-compiled musl libxberg_ffi.so (and its vendored
         shared-lib closure) directly into this project's output directory
         after `dotnet build`, so the CLR's default same-directory native
         library probing finds it without any RID-specific packaging. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../packages/csharp/Xberg/Xberg.csproj" />
  </ItemGroup>
</Project>
