{
  "id": "config_cache_quality",
  "category": "contract",
  "description": "Extracts with result caching and quality processing enabled together",
  "docs": {
    "topic": "configuration",
    "title": "Enable caching and quality processing",
    "description": "Combine the reusable-result cache with quality processing in one extraction configuration.",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].quality_score"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "cache",
    "config",
    "quality"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/pdf/fake_memo.pdf",
        "status_code": 200,
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body_file": "../test_documents/pdf/fake_memo.pdf"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/pdf/fake_memo.pdf"
    }
  },
  "assertions": [
    {
      "type": "not_error"
    },
    {
      "type": "min_length",
      "field": "results[0].content",
      "value": 10
    },
    {
      "type": "greater_than_or_equal",
      "field": "results[0].quality_score",
      "value": 0.0
    },
    {
      "type": "less_than_or_equal",
      "field": "results[0].quality_score",
      "value": 1.0
    }
  ],
  "config": {
    "use_cache": true,
    "enable_quality_processing": true
  }
}
