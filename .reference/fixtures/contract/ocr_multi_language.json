{
  "id": "ocr_multi_language",
  "category": "contract",
  "description": "Configures Tesseract to recognize English, German, and French text",
  "docs": {
    "topic": "ocr",
    "title": "Configure multiple OCR languages",
    "description": "Pass multiple Tesseract language codes as a list",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].content"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": ["contract", "ocr", "tesseract", "multilingual"],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/images/test_hello_world.png",
        "status_code": 200,
        "headers": {
          "content-type": "image/png"
        },
        "body_file": "../test_documents/images/test_hello_world.png"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/images/test_hello_world.png",
      "mime_type": "image/png"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "image/png"
    },
    {
      "type": "contains_all",
      "field": "results[0].content",
      "values": ["Hello", "World"]
    }
  ],
  "skip": {
    "languages": [
      "python",
      "rust",
      "node",
      "go",
      "ruby",
      "elixir",
      "wasm",
      "java",
      "csharp",
      "php",
      "dart",
      "kotlin_android",
      "swift",
      "zig"
    ],
    "reason": "Requires the eng, deu, and fra Tesseract traineddata packs; CI guarantees only English, and WASM bundles only English"
  },
  "config": {
    "ocr": {
      "enabled": true,
      "backend": "tesseract",
      "language": ["eng", "deu", "fra"]
    }
  }
}
