{
  "id": "language_detection_multilingual",
  "category": "contract",
  "description": "Runs multi-language detection over a document containing multiple scripts",
  "docs": {
    "topic": "language-detection",
    "title": "Inspect languages in multilingual content",
    "description": "Enable multi-language detection and inspect every ISO 639-3 code that clears the confidence threshold.",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].detected_languages"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "language-detection",
    "metadata",
    "multilingual"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/markdown/comprehensive.md",
        "status_code": 200,
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body_file": "../test_documents/markdown/comprehensive.md"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/markdown/comprehensive.md",
      "mime_type": "text/markdown"
    }
  },
  "assertions": [
    {
      "type": "not_error"
    },
    {
      "type": "count_min",
      "field": "results[0].detected_languages",
      "value": 1
    }
  ],
  "config": {
    "language_detection": {
      "enabled": true,
      "min_confidence": 0.3,
      "detect_multiple": true
    }
  }
}
