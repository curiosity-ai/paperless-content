{
  "id": "ocr_basic_config",
  "category": "contract",
  "description": "Configures Tesseract OCR for an English PNG image",
  "docs": {
    "topic": "contract",
    "title": "Configure basic OCR",
    "description": "Configure Tesseract OCR for an English PNG image",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].content"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "contract",
    "config",
    "ocr"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/images/test_hello_world.png",
        "status_code": 200,
        "headers": {
          "content-type": "image/png"
        },
        "body_file": "../test_documents/images/test_hello_world.png"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/images/test_hello_world.png",
      "mime_type": "image/png"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "image/png"
    },
    {
      "type": "contains_all",
      "field": "results[0].content",
      "values": [
        "Hello",
        "World"
      ]
    }
  ],
  "config": {
    "ocr": {
      "enabled": true,
      "backend": "tesseract",
      "language": [
        "eng"
      ],
      "tesseract_config": {
        "psm": 6
      }
    }
  }
}
