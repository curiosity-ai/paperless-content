{
  "id": "ocr_force_all_pages",
  "category": "contract",
  "description": "Forces OCR on every PDF page even when a text layer exists",
  "docs": {
    "topic": "ocr",
    "title": "Force OCR on every PDF page",
    "description": "Enable force_ocr to OCR pages that already contain native text",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].content"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": ["contract", "ocr", "tesseract", "pdf"],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/pdf/fake_memo.pdf",
        "status_code": 200,
        "headers": {
          "content-type": "application/pdf"
        },
        "body_file": "../test_documents/pdf/fake_memo.pdf"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/pdf/fake_memo.pdf",
      "mime_type": "application/pdf"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "application/pdf"
    },
    {
      "type": "contains_all",
      "field": "results[0].content",
      "values": ["bottles", "blankets", "laptops"]
    }
  ],
  "config": {
    "force_ocr": true,
    "ocr": {
      "enabled": true,
      "backend": "tesseract",
      "language": ["eng"]
    }
  }
}
