{
  "id": "metadata_access",
  "category": "contract",
  "description": "Accesses common and HTML-specific extraction metadata",
  "docs": {
    "topic": "contract",
    "title": "Access extraction metadata",
    "description": "Access common and format-specific extraction metadata",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].metadata"
        },
        {
          "op": "show",
          "path": "results[0].metadata.format.html.title"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "contract",
    "metadata",
    "html"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/html/simple_table.html",
        "status_code": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body_file": "../test_documents/html/simple_table.html"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/html/simple_table.html",
      "mime_type": "text/html"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "text/html"
    },
    {
      "type": "equals",
      "field": "results[0].metadata.format.html.title",
      "value": "Simple Table Test"
    },
    {
      "type": "count_min",
      "field": "results[0].metadata.format.html.headers",
      "value": 2
    }
  ],
  "config": {}
}
