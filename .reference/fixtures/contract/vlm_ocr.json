{
  "id": "vlm_ocr",
  "category": "contract",
  "description": "Uses a vision language model as the OCR backend",
  "docs": {
    "topic": "ocr",
    "title": "Use VLM OCR",
    "description": "Configure liter-llm to extract text with a vision-capable model",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].content"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": ["contract", "ocr", "vlm", "liter-llm"],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/images/test_hello_world.png",
        "status_code": 200,
        "headers": {
          "content-type": "image/png"
        },
        "body_file": "../test_documents/images/test_hello_world.png"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/images/test_hello_world.png",
      "mime_type": "image/png"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "image/png"
    },
    {
      "type": "contains_all",
      "field": "results[0].content",
      "values": ["Hello", "World"]
    }
  ],
  "skip": {
    "languages": [
      "python",
      "rust",
      "node",
      "go",
      "ruby",
      "elixir",
      "wasm",
      "java",
      "csharp",
      "php",
      "dart",
      "kotlin_android",
      "swift",
      "zig"
    ],
    "reason": "Requires the liter-llm feature, a vision-capable provider, and XBERG_LLM_API_KEY; standard offline E2E jobs intentionally provide none of them"
  },
  "config": {
    "force_ocr": true,
    "ocr": {
      "enabled": true,
      "backend": "vlm",
      "language": ["eng"],
      "vlm_config": {
        "model": "openai/gpt-4o-mini",
        "temperature": 0.0
      }
    }
  }
}
