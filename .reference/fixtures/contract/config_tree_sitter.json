{
	"id": "config_tree_sitter",
	"description": "Tests tree-sitter configuration round-trip",
	"docs": {
		"topic": "contract",
		"title": "Tests tree-sitter configuration round-trip",
		"description": "Tests tree-sitter configuration round-trip",
		"side_effects": "server"
	},
	"tags": ["contract", "config", "tree-sitter"],
	"call": "extract",
	"input": {
		"mock_responses": [
			{
				"path": "/code/hello.py",
				"status_code": 200,
				"headers": {
					"content-type": "application/octet-stream"
				},
				"body_file": "../test_documents/code/hello.py"
			}
		],
		"extract_input": {
			"kind": "uri",
			"uri": "$mock_url/code/hello.py"
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "results[0].mime_type",
			"value": "text/x-source-code"
		},
		{
			"type": "min_length",
			"field": "results[0].content",
			"value": 5
		}
	],
	"skip": {
		"languages": ["wasm"],
		"reason": "The wasm binding has no tree_sitter config field: tree-sitter is excluded from the `wasm-target` feature (crates/xberg/Cargo.toml) because the 371-grammar static pack pushes the .wasm past jsDelivr's 50 MB per-file limit, so neither TreeSitterConfig nor ExtractionConfig.tree_sitter is generated in crates/xberg-wasm. Unblocking this needs a curated tree-sitter-wasm-lite grammar set, not a fixture change."
	},
	"config": {
		"tree_sitter": {
			"languages": ["python", "rust"],
			"groups": ["web"],
			"process": {
				"structure": true,
				"imports": true,
				"exports": true,
				"comments": false,
				"docstrings": false,
				"symbols": false,
				"diagnostics": false
			}
		}
	}
}
