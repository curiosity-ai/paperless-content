{
  "id": "ocr_dpi_config",
  "category": "contract",
  "description": "Configures Tesseract image preprocessing at 300 DPI",
  "docs": {
    "topic": "config",
    "title": "Configure OCR DPI",
    "description": "Set the target DPI through Tesseract image preprocessing",
    "presentation": {
      "operations": [
        {
          "op": "show",
          "path": "results[0].content"
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": ["contract", "config", "ocr", "dpi"],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/images/test_hello_world.png",
        "status_code": 200,
        "headers": {
          "content-type": "image/png"
        },
        "body_file": "../test_documents/images/test_hello_world.png"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/images/test_hello_world.png",
      "mime_type": "image/png"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "image/png"
    },
    {
      "type": "contains_all",
      "field": "results[0].content",
      "values": ["Hello", "World"]
    }
  ],
  "config": {
    "ocr": {
      "enabled": true,
      "backend": "tesseract",
      "language": ["eng"],
      "tesseract_config": {
        "preprocessing": {
          "target_dpi": 300
        }
      }
    }
  }
}
