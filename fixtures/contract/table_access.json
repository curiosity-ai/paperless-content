{
  "id": "table_access",
  "category": "contract",
  "description": "Accesses structured table cells and Markdown output",
  "docs": {
    "topic": "contract",
    "title": "Access extracted tables",
    "description": "Iterate through structured table cells and Markdown output",
    "presentation": {
      "operations": [
        {
          "op": "iterate",
          "path": "results[0].tables",
          "item": "table",
          "fields": [
            "cells",
            "markdown"
          ]
        }
      ]
    },
    "side_effects": "server"
  },
  "tags": [
    "contract",
    "tables",
    "html"
  ],
  "call": "extract",
  "input": {
    "mock_responses": [
      {
        "path": "/html/simple_table.html",
        "status_code": 200,
        "headers": {
          "content-type": "text/html"
        },
        "body_file": "../test_documents/html/simple_table.html"
      }
    ],
    "extract_input": {
      "kind": "uri",
      "uri": "$mock_url/html/simple_table.html",
      "mime_type": "text/html"
    }
  },
  "assertions": [
    {
      "type": "equals",
      "field": "results[0].mime_type",
      "value": "text/html"
    },
    {
      "type": "count_min",
      "field": "results[0].tables",
      "value": 2
    },
    {
      "type": "contains_all",
      "field": "results[0].tables[0].markdown",
      "values": [
        "Product",
        "Category",
        "Laptop",
        "$999.99"
      ]
    }
  ],
  "config": {}
}
